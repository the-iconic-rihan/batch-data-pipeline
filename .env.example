# Copied to .env by `make setup`. AIRFLOW_UID is appended automatically.

# Size of each synthetic daily extract. Lower it (e.g. 100000) on a small laptop.
ROWS_PER_DAY=1000000

# Fail the run (and publish nothing) if more than this share of rows is invalid.
MAX_INVALID_RATIO=0.05

SPARK_DRIVER_MEMORY=2g

CLICKHOUSE_USER=pipeline
CLICKHOUSE_PASSWORD=pipeline
